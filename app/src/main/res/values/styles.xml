<resources>
    <style name="AppTheme" parent="Theme.Base.Aurora">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="alertDialogTheme">@style/Theme.Dialog.Aurora</item>
    </style>

    <style name="AppTheme.AppBarOverlay" parent="Theme.Base.Overlay.HighContrast">
    </style>

    <style name="AppTheme.PopupOverlay" parent="Theme.Base.Overlay.MediumContrast">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
    </style>

    <style name="Theme.Dialog.Aurora" parent="Theme.Base.Overlay.MediumContrast">
        <item name="android:colorBackground">?attr/colorSurface</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="colorAccent">?attr/colorPrimary</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>